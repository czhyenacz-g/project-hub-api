NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://project_hub_user:change_me@localhost:5432/project_hub

PROJECT_HUB_API_KEY=change_me_long_random_token

# Optional — secret for the Hetzner cron job that generates training challenges.
# See docs/ops/training-challenge-cron.md. Leave unset to disable the endpoint.
TRAINING_CRON_SECRET=change_me_long_random_token

# Optional — Bearer token for the nocni-hlidac endpoints (separate project,
# separate token from PROJECT_HUB_API_KEY). See docs/operations/nocni-hlidac.md.
# Leave unset to make those endpoints always reject with 401 (fail closed).
NOCNI_HLIDAC_API_TOKEN=change_me_long_random_token

CORS_ORIGINS=http://localhost:3000,https://osmaliga.cz,https://www.osmaliga.cz
