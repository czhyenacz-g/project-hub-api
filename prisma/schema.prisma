generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OsmaMatchResult {
  id              String   @id @default(cuid())
  homeTeamSlug    String
  homeTeamName    String
  awayTeamSlug    String
  awayTeamName    String
  homeScore       Int
  awayScore       Int
  mode            String   @default("singleplayer")
  durationSeconds Int
  matchComment    String
  playedAt        DateTime
  createdAt       DateTime @default(now())
  onlineMatchId   String?

  @@index([playedAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model OsmaOnlineMatch {
  id              String   @id @default(cuid())
  gameCode        String   @unique
  status          String   @default("finished")
  homeTeamSlug    String
  homeTeamName    String
  awayTeamSlug    String
  awayTeamName    String
  homeScore       Int
  awayScore       Int
  winnerSide      String?
  lobbyCreatedAt  DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  durationSeconds Int?
  finishReason    String   @default("full_time")
  publicResultId  String?
  savedAt         DateTime @default(now())
  homeUserId      String?
  awayUserId      String?
  homeClubId      String?
  awayClubId      String?
  homeClubPoints  Int?
  awayClubPoints  Int?
  homeUser        OsmaUser?  @relation("HomeUser", fields: [homeUserId], references: [id], onDelete: SetNull)
  awayUser        OsmaUser?  @relation("AwayUser", fields: [awayUserId], references: [id], onDelete: SetNull)
  homeClub        OsmaClub?  @relation("OsmaOnlineMatchHomeClub", fields: [homeClubId], references: [id])
  awayClub        OsmaClub?  @relation("OsmaOnlineMatchAwayClub", fields: [awayClubId], references: [id])
  events          OsmaOnlineMatchEvent[]

  @@index([savedAt(sort: Desc)])
  @@index([gameCode])
  @@index([homeUserId])
  @@index([awayUserId])
  @@index([homeClubId])
  @@index([awayClubId])
}

model OsmaUser {
  id          String   @id @default(cuid())
  discordId   String   @unique
  username    String
  globalName  String?
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  homeMatches OsmaOnlineMatch[] @relation("HomeUser")
  awayMatches OsmaOnlineMatch[] @relation("AwayUser")
  createdTournaments     Tournament[]      @relation("TournamentCreatedBy")
  claimedTournamentTeams TournamentTeam[]  @relation("TournamentTeamClaimedBy")

  @@index([discordId])
}

model OsmaClub {
  id             String   @id
  slug           String   @unique
  name           String
  shortName      String?
  city           String?
  location       String?
  note           String?
  colors         String?
  motto          String
  description    String
  seasonComment  String?
  banner         String?
  logo           String?
  primaryColor   String?
  secondaryColor String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  homeOnlineMatches OsmaOnlineMatch[] @relation("OsmaOnlineMatchHomeClub")
  awayOnlineMatches OsmaOnlineMatch[] @relation("OsmaOnlineMatchAwayClub")

  @@index([sortOrder])
  @@index([isActive])
}

model OsmaOnlineMatchEvent {
  id             String          @id @default(cuid())
  onlineMatchId  String
  onlineMatch    OsmaOnlineMatch @relation(fields: [onlineMatchId], references: [id], onDelete: Cascade)
  gameCode       String
  type           String
  matchSecond    Int?
  teamSide       String?
  teamName       String?
  actorLabel     String?
  homeScoreAfter Int?
  awayScoreAfter Int?
  message        String?
  metadataJson   Json?
  createdAt      DateTime @default(now())

  @@index([onlineMatchId])
  @@index([gameCode])
}

// Osmá liga — turnaje (step 1: založení + týmy only, see
// src/modules/osmaLiga/tournamentService.ts). No matches/scheduling/claim yet
// — status is always "open" for now, winnerTeamId/startedAt/finishedAt are
// placeholders for later steps.
model Tournament {
  id              String    @id @default(cuid())
  publicCode      String    @unique
  name            String
  createdByUserId String
  createdBy       OsmaUser  @relation("TournamentCreatedBy", fields: [createdByUserId], references: [id])
  status          String    @default("open")
  playerCount     Int
  format          String
  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  winnerTeamId    String?
  teams           TournamentTeam[]
  matches         TournamentMatch[]

  @@index([createdByUserId])
}

model TournamentTeam {
  id              String    @id @default(cuid())
  tournamentId    String
  tournament      Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  slotNumber      Int
  name            String
  claimedByUserId String?
  claimedByUser   OsmaUser?  @relation("TournamentTeamClaimedBy", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  claimedAt       DateTime?
  seed            Int?
  finalRank       Int?
  createdAt       DateTime  @default(now())
  homeMatches     TournamentMatch[] @relation("TournamentMatchHomeTeam")
  awayMatches     TournamentMatch[] @relation("TournamentMatchAwayTeam")

  @@unique([tournamentId, slotNumber])
  // Enforces "one claimed team per user per tournament" at the DB level —
  // Postgres treats NULL as distinct for uniqueness, so any number of
  // unclaimed (claimedByUserId: null) teams are unaffected, but a second row
  // with the same (tournamentId, claimedByUserId) can never be committed even
  // under a race (see claimTournamentTeam in tournamentService.ts).
  @@unique([tournamentId, claimedByUserId])
  @@index([tournamentId])
}

// Osmá liga — turnajový rozpis (step: start turnaje + generování zápasů, see
// generateTournamentMatches/startTournament in tournamentService.ts). No
// online-match linkage, no result recording, no standings/playoff generation
// yet — matches are created as "scheduled" placeholders only.
model TournamentMatch {
  id            String    @id @default(cuid())
  tournamentId  String
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  phase         String
  roundNumber   Int
  matchNumber   Int
  homeTeamId    String
  homeTeam      TournamentTeam @relation("TournamentMatchHomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId    String
  awayTeam      TournamentTeam @relation("TournamentMatchAwayTeam", fields: [awayTeamId], references: [id])
  homeScore     Int?
  awayScore     Int?
  winnerTeamId  String?
  status        String    @default("scheduled")
  onlineMatchId String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())

  // Defense-in-depth against a duplicate match set from a double-start —
  // the real guard is the atomic Tournament.status compare-and-swap in
  // startTournament(), but this also makes a duplicate insert impossible at
  // the DB level regardless of caller.
  @@unique([tournamentId, roundNumber, matchNumber])
  @@index([tournamentId])
  @@index([tournamentId, phase])
}

// Noční hlídač (nocni-hlidac.vercel.app) — samostatný projekt, žádný vztah k
// Osmé lize. Vercel appka nemá přímé DB připojení, volá jen
// /nocni-hlidac/* endpointy (viz src/modules/nocniHlidac/).
model NocniHlidacPlayer {
  id            String    @id @default(cuid())
  discordUserId String    @unique
  username      String
  displayName   String?
  avatarUrl     String?
  bestRun       Int       @default(0)
  currentRun    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // `lastLoginAt` už existoval PŘED aktivitním logováním (touched on every
  // /nocni-hlidac/player/upsert, tedy i na každý Next.js /api/auth/me
  // self-healing check) — nový POST /nocni-hlidac/player/login (viz
  // activityService.ts) na něj navíc navazuje, ale nemění jeho stávající
  // upsert-time sémantiku (viz report "Idempotence a existující lastLoginAt").
  lastLoginAt   DateTime?
  // Aktivitní logování (viz src/modules/nocniHlidac/activityService.ts,
  // docs/operations/nocni-hlidac.md) — čtyři nová nullable pole, žádná
  // duplicita s `lastLoginAt` výše.
  lastPlayedAt     DateTime?
  lastActivityAt   DateTime?
  lastClient       String?   @db.VarChar(32)
  lastBuildVersion String?   @db.VarChar(64)
  activityEvents   NocniHlidacPlayerActivityEvent[]

  @@index([discordUserId])
  @@index([bestRun(sort: Desc), currentRun(sort: Desc)])
  @@index([lastActivityAt(sort: Desc)])
}

// Malý auditní log herních událostí (viz zadání "Logování hráčské
// aktivity") — VÝHRADNĚ login/game_started/night_survived/player_died,
// žádná obecná telemetrie/metadata_json/IP/user-agent (viz report).
// Append-only — žádný update/delete cesta v service vrstvě.
model NocniHlidacPlayerActivityEvent {
  id           String            @id @default(cuid())
  playerId     String
  player       NocniHlidacPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  eventType    String
  nightNumber  Int?
  gameMode     String?
  client       String?           @db.VarChar(32)
  buildVersion String?           @db.VarChar(64)
  createdAt    DateTime          @default(now())

  @@index([playerId])
  @@index([createdAt(sort: Desc)])
  @@index([playerId, createdAt(sort: Desc)])
}

// Noční hlídač / Objekt 13 — serverový Hardcore-only profil (samostatný z
// NocniHlidacPlayer výše, ten drží jen leaderboard bestRun/currentRun).
// Hardcore true-ending odměna (bestie poražena, dvouhlavňovka odemčená) a
// nejvyšší dosažená Hardcore noc — Normal se sem vůbec neukládá, viz
// src/modules/nocniHlidac/hardcoreProfileService.ts.
model Object13HardcorePlayerProfile {
  id                           String   @id @default(cuid())
  discordUserId                String   @unique
  displayName                  String?
  avatarUrl                    String?
  hardcoreHasDefeatedMonster   Boolean  @default(false)
  hardcoreDoubleBarrelUnlocked Boolean  @default(false)
  hardcoreMonsterDefeatsCount  Int      @default(0)
  hardcoreBestNight            Int      @default(0)
  // Kolikrát hráč v Hardcore zemřel v KTERÉ noci — klíč noc jako string
  // ("1", "2", ...), hodnota počet smrtí. Append-only přírůstek k modelu
  // (viz migrace), zbytek modelu beze změny. Bezpečně Hardcore-only stejně
  // jako ostatní pole zde — nocni-hlidac ho zapisuje jen z Hardcore smrti.
  hardcoreDeathsByNight        Json     @default("{}")
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  lastSeenAt                   DateTime @default(now())

  @@index([discordUserId])
  @@index([hardcoreBestNight(sort: Desc)])
}

// Noční hlídač / Objekt 13 — obecný, mode-agnostic hráčský profil (step 1A of
// the profile/inventory work). Deliberately SEPARATE from both
// NocniHlidacPlayer (leaderboard identity + bestRun/currentRun) and
// Object13HardcorePlayerProfile (Hardcore-only reward/stats) — this model is
// NOT part of the leaderboard and carries no Hardcore-specific fields.
// Connected to the other two only by the same discordUserId string
// convention (no @relation/foreign key on purpose, see report — introducing
// one now would be a bigger identity refactor out of scope for this step).
//
// `profileData` holds the versioned Object13PlayerProfileDataV2 contract —
// `inventory` (countable items, first item is spare bulbs) PLUS `equipment`
// (durable weapon ownership: `ownedWeapons`/`equippedWeaponId`, see
// src/modules/nocniHlidac/playerProfileEquipment.ts and
// playerProfileContractV2.ts). A V1 row (profileVersion 1, no `equipment`)
// is migrated to V2 lazily on GET, see
// playerProfileService.ts#getOrCreateObject13PlayerProfile — this column
// default is a STATIC fallback only (Postgres can't call application code);
// the application's own factory (createDefaultObject13PlayerProfileDataV2)
// is the real source of truth for what a new profile looks like, every row
// is actually created through getOrCreateObject13PlayerProfile, which always
// writes that factory's output explicitly, so this column default is never
// hit in practice. It only needs to change if it drifts badly enough from
// the factory to matter for some hypothetical row inserted outside the app.
// `revision` exists from day one for optimistic locking on PUT (see
// playerProfileService.ts#updateObject13PlayerProfile) — callers must supply
// the revision they last read; a stale value is rejected (409), never
// silently overwritten.
model Object13PlayerProfile {
  id             String   @id @default(cuid())
  discordUserId  String   @unique
  profileVersion Int      @default(2)
  profileData    Json     @default("{\"inventory\":{\"items\":{\"bulb\":10}},\"equipment\":{\"ownedWeapons\":[],\"equippedWeaponId\":null}}")
  revision       Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastSeenAt     DateTime @default(now())

  @@index([discordUserId])
  @@index([updatedAt(sort: Desc)])
}
