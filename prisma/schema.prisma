generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OsmaMatchResult {
  id              String   @id @default(cuid())
  homeTeamSlug    String
  homeTeamName    String
  awayTeamSlug    String
  awayTeamName    String
  homeScore       Int
  awayScore       Int
  mode            String   @default("singleplayer")
  durationSeconds Int
  matchComment    String
  playedAt        DateTime
  createdAt       DateTime @default(now())
  onlineMatchId   String?

  @@index([playedAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model OsmaOnlineMatch {
  id              String   @id @default(cuid())
  gameCode        String   @unique
  status          String   @default("finished")
  homeTeamSlug    String
  homeTeamName    String
  awayTeamSlug    String
  awayTeamName    String
  homeScore       Int
  awayScore       Int
  winnerSide      String?
  lobbyCreatedAt  DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  durationSeconds Int?
  finishReason    String   @default("full_time")
  publicResultId  String?
  savedAt         DateTime @default(now())
  homeUserId      String?
  awayUserId      String?
  homeClubId      String?
  awayClubId      String?
  homeClubPoints  Int?
  awayClubPoints  Int?
  homeUser        OsmaUser?  @relation("HomeUser", fields: [homeUserId], references: [id], onDelete: SetNull)
  awayUser        OsmaUser?  @relation("AwayUser", fields: [awayUserId], references: [id], onDelete: SetNull)
  homeClub        OsmaClub?  @relation("OsmaOnlineMatchHomeClub", fields: [homeClubId], references: [id])
  awayClub        OsmaClub?  @relation("OsmaOnlineMatchAwayClub", fields: [awayClubId], references: [id])
  events          OsmaOnlineMatchEvent[]

  @@index([savedAt(sort: Desc)])
  @@index([gameCode])
  @@index([homeUserId])
  @@index([awayUserId])
  @@index([homeClubId])
  @@index([awayClubId])
}

model OsmaUser {
  id          String   @id @default(cuid())
  discordId   String   @unique
  username    String
  globalName  String?
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  homeMatches OsmaOnlineMatch[] @relation("HomeUser")
  awayMatches OsmaOnlineMatch[] @relation("AwayUser")

  @@index([discordId])
}

model OsmaClub {
  id             String   @id
  slug           String   @unique
  name           String
  shortName      String?
  city           String?
  location       String?
  note           String?
  colors         String?
  motto          String
  description    String
  seasonComment  String?
  banner         String?
  logo           String?
  primaryColor   String?
  secondaryColor String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  homeOnlineMatches OsmaOnlineMatch[] @relation("OsmaOnlineMatchHomeClub")
  awayOnlineMatches OsmaOnlineMatch[] @relation("OsmaOnlineMatchAwayClub")

  @@index([sortOrder])
  @@index([isActive])
}

model OsmaOnlineMatchEvent {
  id             String          @id @default(cuid())
  onlineMatchId  String
  onlineMatch    OsmaOnlineMatch @relation(fields: [onlineMatchId], references: [id], onDelete: Cascade)
  gameCode       String
  type           String
  matchSecond    Int?
  teamSide       String?
  teamName       String?
  actorLabel     String?
  homeScoreAfter Int?
  awayScoreAfter Int?
  message        String?
  metadataJson   Json?
  createdAt      DateTime @default(now())

  @@index([onlineMatchId])
  @@index([gameCode])
}

// Noční hlídač (nocni-hlidac.vercel.app) — samostatný projekt, žádný vztah k
// Osmé lize. Vercel appka nemá přímé DB připojení, volá jen
// /nocni-hlidac/* endpointy (viz src/modules/nocniHlidac/).
model NocniHlidacPlayer {
  id            String    @id @default(cuid())
  discordUserId String    @unique
  username      String
  displayName   String?
  avatarUrl     String?
  bestRun       Int       @default(0)
  currentRun    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  @@index([discordUserId])
  @@index([bestRun(sort: Desc), currentRun(sort: Desc)])
}

// Noční hlídač / Objekt 13 — serverový Hardcore-only profil (samostatný z
// NocniHlidacPlayer výše, ten drží jen leaderboard bestRun/currentRun).
// Hardcore true-ending odměna (bestie poražena, dvouhlavňovka odemčená) a
// nejvyšší dosažená Hardcore noc — Normal se sem vůbec neukládá, viz
// src/modules/nocniHlidac/hardcoreProfileService.ts.
model Object13HardcorePlayerProfile {
  id                           String   @id @default(cuid())
  discordUserId                String   @unique
  displayName                  String?
  avatarUrl                    String?
  hardcoreHasDefeatedMonster   Boolean  @default(false)
  hardcoreDoubleBarrelUnlocked Boolean  @default(false)
  hardcoreMonsterDefeatsCount  Int      @default(0)
  hardcoreBestNight            Int      @default(0)
  // Kolikrát hráč v Hardcore zemřel v KTERÉ noci — klíč noc jako string
  // ("1", "2", ...), hodnota počet smrtí. Append-only přírůstek k modelu
  // (viz migrace), zbytek modelu beze změny. Bezpečně Hardcore-only stejně
  // jako ostatní pole zde — nocni-hlidac ho zapisuje jen z Hardcore smrti.
  hardcoreDeathsByNight        Json     @default("{}")
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  lastSeenAt                   DateTime @default(now())

  @@index([discordUserId])
  @@index([hardcoreBestNight(sort: Desc)])
}

// Noční hlídač / Objekt 13 — obecný, mode-agnostic hráčský profil (step 1A of
// the profile/inventory work). Deliberately SEPARATE from both
// NocniHlidacPlayer (leaderboard identity + bestRun/currentRun) and
// Object13HardcorePlayerProfile (Hardcore-only reward/stats) — this model is
// NOT part of the leaderboard and carries no Hardcore-specific fields.
// Connected to the other two only by the same discordUserId string
// convention (no @relation/foreign key on purpose, see report — introducing
// one now would be a bigger identity refactor out of scope for this step).
//
// `profileData` holds the versioned Object13PlayerProfileDataV1 contract
// (inventory of countable items, first item is spare bulbs) — see
// src/modules/nocniHlidac/playerProfileInventory.ts and
// playerProfileTypes.ts#createDefaultObject13PlayerProfileData. The column
// default below is a STATIC fallback only (Postgres can't call application
// code) — the application's own factory
// (createDefaultObject13PlayerProfileDataV1) is the real source of truth for
// what a new profile looks like; every row is actually created through
// getOrCreateObject13PlayerProfile, which always writes that factory's
// output explicitly, so this column default is never hit in practice. It
// only needs to change if it drifts badly enough from the factory to matter
// for some hypothetical row inserted outside the app.
// `revision` exists from day one for optimistic locking on PUT (see
// playerProfileService.ts#updateObject13PlayerProfile) — callers must supply
// the revision they last read; a stale value is rejected (409), never
// silently overwritten.
model Object13PlayerProfile {
  id             String   @id @default(cuid())
  discordUserId  String   @unique
  profileVersion Int      @default(1)
  profileData    Json     @default("{\"inventory\":{\"items\":{\"bulb\":10}}}")
  revision       Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastSeenAt     DateTime @default(now())

  @@index([discordUserId])
  @@index([updatedAt(sort: Desc)])
}
